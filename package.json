{
  "name": "audio-recorder",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "start:go": "expo start --go",
    "start:tunnel": "APP_VARIANT=development expo start --tunnel",
    "start:mcp": "APP_VARIANT=development EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:device": "APP_VARIANT=development expo run:ios --device",
    "android": "APP_VARIANT=development expo run:android",
    "android:device": "APP_VARIANT=development expo run:android --device",
    "native:clean": "APP_VARIANT=development expo prebuild --clean",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test -- --ci",
    "typecheck": "expo customize tsconfig.json > /dev/null && tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "node scripts/e2e.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:expo": "npx --yes expo-doctor@latest",
    "new-app": "node scripts/new-app.mjs",
    "create-app": "node scripts/create-app.mjs",
    "sync-base": "node scripts/sync-base.mjs",
    "eas": "npx --yes eas-cli@latest",
    "build:dev": "npx --yes eas-cli@latest build --profile development",
    "build:dev:sim": "npx --yes eas-cli@latest build:dev",
    "build:preview": "npx --yes eas-cli@latest build --profile preview",
    "build:production": "npx --yes eas-cli@latest build --profile production",
    "release": "npx --yes eas-cli@latest build --profile production --platform all --auto-submit",
    "update:preview": "APP_VARIANT=preview npx --yes eas-cli@latest update --channel preview --environment preview",
    "update:production": "APP_VARIANT=production npx --yes eas-cli@latest update --channel production --environment production",
    "deploy": "npx --yes eas-cli@latest workflow:run .eas/workflows/deploy-production.yml"
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.24",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "~1.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo-mcp": "~0.2.1",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "config": {
    "bundleIdPrefix": "com.didrio"
  }
}
